#!/usr/bin/env bash
# Runs only for git commands Claude Code issues: SessionStart points
# core.hooksPath here through GIT_CONFIG_* variables in Claude's shells.
# Claude Code asks before each push; this refuses the pushes never allowed.
set -euo pipefail

remote=$1
url=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
url=${url%/}
url=${url%.git}

deny() {
  echo "pre-push (.claude/git-hooks): $*" >&2
  exit 1
}

case "$url" in
  *[:/]ddev/ddev) deny "agents push only to forks, never to ddev/ddev (remote '$remote')" ;;
esac

input=$(cat)
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z $local_ref ]]; then
    continue
  fi
  if [[ $remote_ref != refs/heads/* ]]; then
    deny "only branches may be pushed, not $remote_ref"
  fi
  if [[ $local_sha =~ ^0+$ ]]; then
    deny "deleting $remote_ref is not allowed"
  fi
  # A remote commit missing locally also fails here, as it would without --force.
  if [[ ! $remote_sha =~ ^0+$ ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    deny "$remote_ref would not be a fast-forward; force pushes are not allowed"
  fi
done <<<"$input"

# core.hooksPath hides the repository's own hooks, so run its pre-push too.
hook="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [[ -x $hook ]]; then
  printf '%s\n' "$input" | "$hook" "$@"
fi
