# this variable is passed to all containers
# and in case of "web" container, ot will be overridden with value from .env.web file
GLOBAL_TEST_VARIABLE=global_test_variable
# this variable is overridden in the .env.local file
LOCAL_OVERRIDE_VARIABLE=env_value
# this variable is read by the busybox add-on install actions
DOT_ENV_VARIABLE=dot_env_value
