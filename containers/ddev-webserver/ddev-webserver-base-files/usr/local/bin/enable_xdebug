#!/usr/bin/env bash
export PATH=$PATH:/usr/sbin:/sbin
phpenmod xdebug
# Let Xdebug translate container paths to host paths, so IDEs need no pathMappings.
# Best-effort: a failure here must never prevent enabling Xdebug.
if [ "${DDEV_XDEBUG_PATH_MAPPING:-}" = "true" ] && [ -n "${DDEV_HOST_APPROOT:-}" ]; then
  mkdir -p /var/www/html/.xdebug 2>/dev/null &&
    printf "/var/www/html/ = %s/\n" "${DDEV_HOST_APPROOT}" >/var/www/html/.xdebug/ddev-generated.map 2>/dev/null &&
    printf "# #ddev-generated\n/ddev-generated.map\n/.gitignore\n" >/var/www/html/.xdebug/.gitignore 2>/dev/null || true
fi
if ! php -m 2>/dev/null | grep -qx xdebug; then
  phpdismod xdebug || true
  echo "Xdebug is unavailable for PHP ${DDEV_PHP_VERSION:-current} in this web image." >&2
  exit 1
fi
if [ "${DDEV_WEBSERVER_TYPE:-}" = "generic" ]; then
  # we don't know what process is running php, restart all web_extra_daemons
  supervisorctl restart 'webextradaemons:*' || true
else
  killall -USR2 php-fpm 2>/dev/null || true
fi
# if xdebug is not enabled, there will be a visible warning in stderr
php -m >/dev/null || true
echo "Enabled xdebug"
